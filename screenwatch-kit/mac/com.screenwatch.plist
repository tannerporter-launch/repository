<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Replace __HOME__ with the user's home directory (e.g. /Users/alex),
         then install to ~/Library/LaunchAgents/com.screenwatch.plist and run:
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.screenwatch.plist -->
    <key>Label</key>
    <string>com.screenwatch</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/Applications/Screenwatch.app/Contents/MacOS/screenwatch</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>__HOME__/screenwatch/daemon.log</string>
    <key>StandardOutPath</key>
    <string>__HOME__/screenwatch/daemon.log</string>
</dict>
</plist>
